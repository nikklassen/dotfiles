{{- $x86_64Arch := .chezmoi.arch -}}
{{- if eq $x86_64Arch "amd64" -}}
{{-   $x86_64Arch = "x86_64" -}}
{{- end -}}

[".local"]
  {{ $tag := "nightly" -}}
  {{- if or .mobile (eq .chezmoi.os "darwin") -}}
  {{-   $tag = "stable" -}}
  {{- end -}}
  {{- $os := .chezmoi.os }}
  {{- if eq $os "darwin" -}}
  {{-   $os = "macos" -}}
  {{- end -}}
  {{- $asset := (printf "nvim-%s-%s.tar.gz" $os $x86_64Arch ) -}}
  {{- if eq $os "windows" -}}
  {{-   $asset = "nvim-win64.zip" -}}
  {{- end -}}
  type = "archive"
  stripComponents = 1
  refreshPeriod = '24h'
  url = {{ gitHubReleaseAssetURL "neovim/neovim" $tag $asset | quote }}
