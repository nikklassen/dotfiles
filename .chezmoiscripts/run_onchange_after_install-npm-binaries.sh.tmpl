#!/bin/bash

# node-version: {{ output "node" "--version" }}

if [[ -n "$(which update-bun-token)" ]]; then
  update-bun-token
fi

bun install -g {{ .packages.npm | join " " }} || true

{{ if not .work }}
bun install -g @anthropic-ai/claude-code || true
{{ end }}

{{ if not .mobile }}
bun install -g tree-sitter-cli || true
{{ end }}
