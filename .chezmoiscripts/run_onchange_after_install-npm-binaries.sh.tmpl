#!/bin/bash

# node-version: {{ output "node" "--version" }}

{{- if .work -}}
NPM_BIN="npm"
{{ else }}
NPM_BIN="bun"
{{- end }}

if [[ -n "$(which update-bun-token)" ]]; then
  update-bun-token
fi

"${NPM_BIN?}" install -g {{ .packages.npm | join " " }} || true

{{ if not .work }}
"${NPM_BIN?}" install -g @anthropic-ai/claude-code || true
{{ end }}

{{ if not .mobile }}
"${NPM_BIN?}" install -g tree-sitter-cli || true
{{ end }}
