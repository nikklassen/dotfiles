{
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}${/}hooks${/}update_tmux_title.sh"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "description": "reset tmux pane",
            "command": "${extensionPath}${/}hooks${/}reset_tmux_title.sh"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "description": "reset tmux pane",
            "command": "${extensionPath}${/}hooks${/}reset_tmux_title.sh"
          }
        ]
      }
    ]
  }
}
